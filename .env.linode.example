# ==============================================================================
# Environment Configuration for Akamai Linode Production Deployment
# Salin file ini menjadi .env di server Linode: cp .env.linode.example .env
# ==============================================================================

# Database Credentials
POSTGRES_DB=fire_sentinel_db
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=GantiPasswordKuatPostgres123!
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# ML Worker
ML_PORT=50051

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# External AI Credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AMD_API_KEY=
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_MODEL=Qwen3.8-Flash-Next

# Image Registry (Diperbarui oleh GitHub Actions)
BACKEND_IMAGE=ghcr.io/ayusuf29/karhutla-control-plane-backend:latest
MLWORKER_IMAGE=ghcr.io/ayusuf29/karthutla-ml-worker:latest

# Cloudflare Tunnel Token (Hanya jika menggunakan Opsi 2 Cloudflare Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
